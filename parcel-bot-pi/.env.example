# ---------------------------------------------------------------------------
# Parcel Tracker bot — configuration
#
# This is the ONLY file you need to edit.
#   * On the Pi it lives at:  /etc/parcel-bot/env
#   * For a manual run:       ./.env  (next to parcel_bot.py)
#
# Format: KEY=VALUE, one per line, no quotes. Lines starting with # are ignored.
# After editing:  sudo systemctl restart parcel-bot
# Keep it private: sudo chmod 600 /etc/parcel-bot/env
# ---------------------------------------------------------------------------

# --- Telegram (required) ---------------------------------------------------
# From @BotFather -> /newbot. Keep the colon and everything after it.
TELEGRAM_BOT_TOKEN=PASTE_BOT_TOKEN_HERE

# --- Discord (optional) ----------------------------------------------------
# Used automatically for reminders created by an admin.
# Server Settings -> Integrations -> Webhooks -> Copy Webhook URL
DISCORD_WEBHOOK_URL=

# --- Owner access (required for /admin) ------------------------------------
# Comma-separated numeric chat ids. Send /start to the bot, then look for
# "new user 123456789 · @yourhandle" in the log.
ADMIN_USER_IDS=

# --- Free tier -------------------------------------------------------------
# Non-admin users: FREE_TRACKS lookups per WINDOW_HOURS hours.
FREE_TRACKS=2
WINDOW_HOURS=3

# --- Tracking mode ---------------------------------------------------------
# live     = real lookups against speedposttrack.io  (production)
# fixtures = offline snapshots in ./fixtures         (testing only)
TRACKING_MODE=live
